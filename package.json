{
  "name": "rosse",
  "version": "0.0.0",
  "private": true,
  "description": "Rosse, the hand-drawn galaxy engine, reimplemented on WebGPU.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run prepare-assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "node tools/gpu-test/run.mjs",
    "vectors": "node tools/rng-vectors.mjs",
    "vectors:camera": "node tools/camera-vectors.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate:wgsl": "node tools/validate-wgsl.mjs",
    "prepare-assets": "node tools/pack-atlas/pack.mjs",
    "screenshots": "node tools/gpu-test/screenshot.mjs",
    "golden": "node tests/golden/compare/compare.mjs",
    "perf": "node tools/perf/perf.mjs",
    "perf:worker": "node tools/perf/worker.mjs",
    "capture:reference": "node tools/capture-reference/capture.mjs",
    "profile:reference": "node tools/profile-reference/profile.mjs",
    "spike": "node spikes/vector-lines/run.mjs",
    "predev": "npm run prepare-assets",
    "prebuild": "npm run prepare-assets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.66",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wgsl_reflect": "^1.6.0"
  }
}
