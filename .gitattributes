# Normalise text files to LF.
* text=auto eol=lf

# The asset pack under assets/ is committed as ordinary blobs (see docs/open-questions.md).
# New binaries go to Git LFS:
tests/golden/**/*.png filter=lfs diff=lfs merge=lfs -text
tests/golden/**/*.jpg filter=lfs diff=lfs merge=lfs -text
spikes/**/*.png filter=lfs diff=lfs merge=lfs -text

# Binary types elsewhere: never diff or normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.ttf binary
*.otf binary
