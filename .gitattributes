# Normalise text files to LF.
* text=auto eol=lf

# Binaries are committed as ordinary blobs (Git LFS is not used): keep new ones small,
# screenshots as JPEG where possible.

# Binary types: never diff or normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.ttf binary
*.otf binary
