# Normalise text files to LF.
* text=auto eol=lf

# Binaries are ordinary Git blobs. Git LFS was planned for goldens and screenshots, but LFS
# uploads are refused from the environment this project is built in; see docs/open-questions.md Q11.

# Binary types elsewhere: never diff or normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.ttf binary
*.otf binary
